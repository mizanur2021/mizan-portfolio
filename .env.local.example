# Copy this file to .env.local for local development, or add these in
# Vercel → Project Settings → Environment Variables for production.
#
# Setup steps: see ADMIN_SETUP.md

# --- Admin panel login -------------------------------------------------
# Pick your own strong password. This is the ONLY credential you need to
# choose yourself — everything else below is auto-filled by Vercel once
# you connect the integrations.
ADMIN_PASSWORD=

# --- Database (Vercel Postgres) -----------------------------------------
# Vercel dashboard → your project → Storage → Create Database → Postgres
# → Connect to this project. Vercel then injects POSTGRES_URL automatically
# in production; for local dev, run `vercel env pull .env.local` after
# connecting it, which fills this in for you.
POSTGRES_URL=

# --- Image storage (Vercel Blob) ----------------------------------------
# Vercel dashboard → your project → Storage → Create → Blob
# → Connect to this project. Same auto-fill behavior as above.
BLOB_READ_WRITE_TOKEN=
